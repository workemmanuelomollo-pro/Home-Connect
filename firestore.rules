rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'admin@billion.com'
        && request.auth.token.email_verified == true;
    }

    function isOwnProfile(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validUserProfileCreate(userId) {
      return isOwnProfile(userId)
        && request.resource.data.uid == userId
        && request.resource.data.emailVerified == request.auth.token.email_verified
        && request.resource.data.role in ['customer', 'provider']
        && request.resource.data.applicationStatus in [null, 'pending']
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'emailVerified',
          'displayName',
          'photoURL',
          'role',
          'applicationStatus',
          'providerData',
          'accountStatus',
          'createdAt',
          'updatedAt'
        ]);
    }

    function validOwnProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'displayName',
          'photoURL',
          'role',
          'applicationStatus',
          'providerData',
          'updatedAt'
        ])
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.role in ['customer', 'provider']
        && (
          request.resource.data.applicationStatus == resource.data.applicationStatus
          || request.resource.data.applicationStatus in [null, 'pending']
        );
    }

    function validBookingTransition(previousStatus, nextStatus) {
      return (
          previousStatus == 'pending'
          && nextStatus in ['contact_initiated', 'accepted', 'cancelled']
        )
        || (
          previousStatus == 'contact_initiated'
          && nextStatus in ['accepted', 'cancelled']
        )
        || (
          previousStatus == 'accepted'
          && nextStatus in ['in_progress', 'cancelled']
        )
        || (previousStatus == 'in_progress' && nextStatus == 'completed');
    }

    match /users/{userId} {
      allow get: if isOwnProfile(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if validUserProfileCreate(userId);
      allow update: if isAdmin()
        || (isOwnProfile(userId) && validOwnProfileUpdate());
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow get, list: if isSignedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.providerId == request.auth.uid
          || isAdmin()
        );

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt'
          ])
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.providerId == resource.data.providerId
          && (
            (
              resource.data.providerId == request.auth.uid
              && validBookingTransition(resource.data.status, request.resource.data.status)
            )
            || (
              resource.data.customerId == request.auth.uid
              && resource.data.status in ['pending', 'contact_initiated', 'accepted']
              && request.resource.data.status == 'cancelled'
            )
          )
        );

      allow delete: if isAdmin();
    }
  }
}
